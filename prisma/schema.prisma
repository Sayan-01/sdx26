generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Plan {
  id             String         @id @default(uuid())
  name           String         @unique
  maxTeamMembers Int
  maxProjects    Int
  maxStorageGb   Int
  priceMonthly   Decimal        @db.Decimal(10, 2)
  priceYearly    Decimal        @db.Decimal(10, 2)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  agencies       Agency[]
  subscriptions  Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(uuid())
  agencyId             String             @unique
  planId               String
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  trialEnd             DateTime?
  cancelAt             DateTime?
  canceledAt           DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  agency               Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Agency {
  id            String         @id @default(cuid())
  name          String
  ownerId       String         @unique
  slug          String         @unique
  logoUrl       String?
  planId        String?
  activePlan    String?        @default("basic")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  activityLogs  ActivityLog[]
  owner         User           @relation("AgencyOwner", fields: [ownerId], references: [id])
  plan          Plan?          @relation(fields: [planId], references: [id])
  teamMembers   TeamMember[]
  users         User[]         @relation("AgencyUsers")
  clients       Client[]
  invitations   Invitation[]
  notifications Notification[]
  projects      Project[]
  changeRequests ChangeRequest[]
  subscription  Subscription?
}

model User {
  id                      String           @id @default(cuid())
  name                    String?
  email                   String           @unique
  password                String?
  role                    UserRole         @default(OWNER)
  source                  String?
  varifiedToken           String?
  varifiedTokenExpire     DateTime?
  avatarUrl               String?
  agencyId                String?
  googleId                String?
  githubId                String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  actorActivityLogs       ActivityLog[]    @relation("ActorUser")
  activityLogs            ActivityLog[]
  ownedAgency             Agency?          @relation("AgencyOwner")
  uploadedFiles           File[]
  sentMessages            Message[]        @relation("UserMessages")
  messages                Message[]
  projectMemberships      ProjectMember[]
  teamMembers             TeamMember[]
  agency                  Agency?          @relation("AgencyUsers", fields: [agencyId], references: [id], onDelete: SetNull)
  fileVersions            FileVersion[]
  invitationsSent         Invitation[]     @relation("InvitedBy")
  notifications           Notification[]   @relation("UserNotifications")
  reviewedOnboardingItems OnboardingItem[] @relation("ReviewedBy")
  onboardingItems         OnboardingItem[]
  assignedTasks           Task[]           @relation("TaskAssignee")
}

model Invitation {
  id          String      @id @default(uuid())
  agencyId    String
  name        String
  email       String
  designation Designation
  token       String      @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  status      InviteStatus     @default(PENDING)
  createdAt   DateTime    @default(now())
  agency      Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  invitedBy   User        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([agencyId, email])
  @@map("invitations")
}

model TeamMember {
  id          String   @id @default(cuid())
  agencyId    String
  userId      String
  role        TeamRole @default(TEAM)
  designation String?
  joinedAt    DateTime @default(now())
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
}

model ProjectMember {
  id          String            @id @default(cuid())
  agencyId    String
  projectId   String
  userId      String
  role        ProjectMemberRole @default(MEMBER)
  addedAt     DateTime          @default(now())
  designation String?
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Project {
  id             String           @id @default(cuid())
  name           String
  agencyId       String
  clientId       String
  description    String?
  deadline       DateTime?
  status         ProjectStatus    @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  activityLogs   ActivityLog[]
  files          File[]
  magicLinks     MagicLink[]
  messages       Message[]
  projectMembers ProjectMember[]
  milestones     Milestone[]
  notifications  Notification[]
  onboardingItem OnboardingItem[]
  changeRequests ChangeRequest[]
  agency         Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client         Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@map("projects")
}

model Client {
  id                String           @id @default(uuid())
  agencyId          String
  name              String
  email             String
  company           String?
  phone             String?
  avatarUrl         String?
  isActive          Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  actorLogs         ActivityLog[]    @relation("ActorClient")
  magicLinks        MagicLink[]
  messagesSent      Message[]        @relation("ClientMessages")
  agency            Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  notifications     Notification[]   @relation("ClientNotifications")
  onboardingUploads OnboardingItem[] @relation("UploadedBy")
  projects          Project[]
  changeRequests    ChangeRequest[]

  @@unique([agencyId, email])
  @@map("clients")
}

model OnboardingItem {
  id           String           @id @default(cuid())
  agencyId     String
  projectId    String
  label        String
  status       OnboardingStatus @default(PENDING)
  fileUrl      String?
  uploadedById String?
  reviewedById String?
  updatedAt    DateTime         @updatedAt
  userId       String?
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewedBy   User?            @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  uploadedBy   Client?          @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("onboarding_items")
}

model Milestone {
  id          String          @id @default(cuid())
  agencyId    String
  projectId   String
  title       String
  description String?
  orderIndex  Int
  dueDate     DateTime?
  amount      Float?
  status      MilestoneStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  files       File[]
  messages    Message[]
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payments      Payment?
  tasks         Task[]
  changeRequest ChangeRequest?

  @@unique([projectId, orderIndex])
  @@map("milestones")
}

model File {
  id               String        @id @default(cuid())
  agencyId         String
  projectId        String
  milestoneId      String?
  uploaderId       String
  fileName         String
  fileType         String?
  url              String
  status           FileStatus    @default(UPLOADED)
  currentVersionId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  milestone        Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader         User          @relation(fields: [uploaderId], references: [id])
  messages         Message[]
  fileVersions     FileVersion[]
}

model Message {
  id             String     @id @default(cuid())
  agencyId       String
  projectId      String
  milestoneId    String?
  fileId         String?
  senderId       String
  content        String
  createdAt      DateTime   @default(now())
  senderUserId   String?
  senderClientId String?
  userId         String?
  file           File?      @relation(fields: [fileId], references: [id], onDelete: SetNull)
  milestone      Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderClient   Client?    @relation("ClientMessages", fields: [senderClientId], references: [id], onDelete: SetNull)
  senderUser     User?      @relation("UserMessages", fields: [senderUserId], references: [id], onDelete: SetNull)
  user           User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model FileVersion {
  id            String   @id @default(uuid())
  agencyId      String
  fileId        String
  versionNumber Int
  storageKey    String
  fileName      String
  fileSizeBytes BigInt
  uploadedById  String
  changeNote    String?
  createdAt     DateTime @default(now())
  file          File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])

  @@unique([fileId, versionNumber])
  @@map("file_versions")
}

model Payment {
  id                String         @id @default(uuid())
  agencyId          String
  milestoneId       String         @unique
  amount            Decimal        @db.Decimal(10, 2)
  currency          String         @default("USD")
  status            PaymentStatus  @default(PENDING)
  paymentMethod     PaymentMethod?
  gatewayPaymentId  String?
  gatewayCustomerId String?
  invoiceUrl        String?
  receiptUrl        String?
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  milestone         Milestone      @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Notification {
  id                String           @id @default(uuid())
  agencyId          String
  projectId         String?
  recipientUserId   String?
  recipientClientId String?
  type              NotificationType
  title             String
  body              String
  entityType        EntityType?
  entityId          String?
  isRead            Boolean          @default(false)
  readAt            DateTime?
  createdAt         DateTime         @default(now())
  agency            Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recipientClient   Client?          @relation("ClientNotifications", fields: [recipientClientId], references: [id], onDelete: Cascade)
  recipientUser     User?            @relation("UserNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([agencyId, recipientUserId, isRead])
  @@index([agencyId, recipientClientId, isRead])
  @@map("notifications")
}

model ActivityLog {
  id            String   @id @default(cuid())
  agencyId      String
  projectId     String?
  actorUserId   String?
  actorClientId String?
  action        String
  isRead        Boolean  @default(false)
  metadata      Json?
  entityType    String?
  entityId      String?
  createdAt     DateTime @default(now())
  userId        String?
  actorClient   Client?  @relation("ActorClient", fields: [actorClientId], references: [id], onDelete: SetNull)
  actorUser     User?    @relation("ActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  agency        Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model MagicLink {
  id          String    @id @default(cuid())
  agencyId    String
  projectId   String
  clientId    String?
  clientEmail String
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Task {
  id          String       @id @default(cuid())
  milestoneId String
  projectId   String
  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  milestone   Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

enum UserRole {
  OWNER
  TEAM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum TeamRole {
  OWNER
  TEAM
}

enum Designation {
  DESIGNER
  DEVELOPER
  HR
  PROJECT_MANAGER
  OTHER
  FOUNDER
}

enum ProjectMemberRole {
  OWNER
  MEMBER
  VIEWER
}

enum ProjectStatus {
  PENDING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum OnboardingStatus {
  PENDING
  UPLOADED
  APPROVED
  REJECTED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  IN_REVIEW
  APPROVED
  PAID
}

enum FileStatus {
  UPLOADED
  UNDER_REVIEW
  APPROVED
  REVISION_REQUESTED
}

enum PaymentStatus {
  PENDING
  PAID
}

enum PaymentMethod {
  STRIPE
  RAZORPAY
  MANUAL
  BANK_TRANSFER
}

enum NotificationType {
  FILE_UPLOADED
  MILESTONE_APPROVED
  PAYMENT_DUE
  REVISION_REQUESTED
  NEW_MESSAGE
  ONBOARDING_ITEM
  INVITE
}

enum EntityType {
  PROJECT
  MILESTONE
  FILE
  MESSAGE
  PAYMENT
  ONBOARDING
  MEMBER
  ENTITY
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ChangeRequestStatus {
  SUBMITTED
  NEEDS_REVISION
  PENDING_CLIENT_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  CONVERTED
}

enum ScopeType {
  IN_SCOPE
  NEW_REQUEST
}

enum ChangeRequestCreator {
  AGENCY
  CLIENT
}

model ChangeRequest {
  id                   String              @id @default(cuid())
  agencyId             String
  projectId            String
  clientId             String?
  requestedByRole      ChangeRequestCreator
  title                String
  description          String?
  scopeType            ScopeType           @default(NEW_REQUEST)
  status               ChangeRequestStatus @default(SUBMITTED)
  costImpact           Float?              @default(0)
  timelineImpact       String?
  agencyNote           String?
  clientNote           String?
  convertedMilestoneId String?             @unique
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  agency               Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project              Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client               Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  convertedMilestone   Milestone?          @relation(fields: [convertedMilestoneId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([agencyId])
  @@map("change_requests")
}
